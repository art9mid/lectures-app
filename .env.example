# Supabase → Project Settings → API. Without these, results stay in the browser (localStorage).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Azure Speech (Free F0). Without it the browser voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Site password for the login page. Empty = site is open.
SITE_PASSWORD=
